{
  "name": "@rwx-cloud/playwright-rwx-reporter",
  "version": "0.1.0",
  "description": "Adds RWX retry metadata to Playwright's built-in JSON report.",
  "homepage": "https://github.com/rwx-cloud/playwright-rwx-reporter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwx-cloud/playwright-rwx-reporter.git"
  },
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run lint && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "node --test test/integration.test.js",
    "test:unit": "node --test test/reporter.test.js"
  },
  "engines": {
    "node": ">=20.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6"
  }
}
